{
  "match": "e2e-subagent-child",
  "turns": [
    {
      "calls": [
        {
          "name": "write",
          "arguments": {
            "path": "{{plan_path}}",
            "content": "# Plan\n\n## Steps\n\n- [x] the child reports ok\n"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "parent_notify",
          "arguments": {
            "text": "plan complete: step checked off",
            "done": true,
            "output": { "status": "ok" }
          }
        }
      ]
    },
    { "text": "Plan complete; parent notified. (e2e child turn done)" }
  ],
  "usage": { "input_tokens": 180, "output_tokens": 70, "total_tokens": 250 }
}
