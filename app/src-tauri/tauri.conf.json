{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tau",
  "version": "0.1.0",
  "identifier": "com.aaronlockhartdev.tau",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../svelte/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tau",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "dmg"],
    "copyright": "Copyright (C) 2026 aaronlockhartdev — GNU Affero General Public License v3.0",
    "publisher": "aaronlockhartdev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
