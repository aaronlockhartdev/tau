/target
# the app's own project state when developing tau in this repo (sweep finding T4);
# fixtures/sessions/ is the deliberate hash-pinned E2E fixture and stays tracked
.tau/
# cargo-llvm-cov HTML report dir (the CI rust-coverage job writes it; never tracked)
/coverage/
node_modules/
dist/
# svelte-check --tsgo writes transpiled .svelte files here (TS 7 native diagnostics)
.svelte-check/
# generated by build.rs for `--features e2e` builds only (sweep finding X1)
app/src-tauri/capabilities/e2e.json
# Tauri CLI regenerates these on every build; tracking them only adds spurious diffs
app/src-tauri/gen/schemas/
# agent skills: pulled per-machine from skills-lock.json (npx skills)
.agents/skills/
.pi/skills/
# vitest coverage output
app/coverage/
